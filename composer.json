{
    "name": "scdesign/cms-framework",
    "description": "A PHP 8.4 CMS framework built from scratch",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "CMS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CMS\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test":           "vendor/bin/phpunit",
        "migrate":        "php bin/migrate.php",
        "migrate:status": "php bin/migrate.php --status"
    }
}
